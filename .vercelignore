# Vercel builds from source; anything generated locally only slows the upload
# or trips the 100 MB per-file limit. The per-port .next-* directories are dev
# caches written by scripts/dev.mjs and run to several GB.
node_modules
.next
.next-*
.git
.github
.artifacts
playwright-report
test-results
*.tsbuildinfo
.env
.env.*
!.env.example
.env.bak*

# Not needed at build or run time. data/ holds operational exports with member
# details — they are imported through the app, never shipped with it.
data
docs
scripts
drizzle
*.md

