{
  "name": "iris-support-ticket-hub",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "npx tsx -r dotenv/config src/lib/seed.ts",
    "check:iris": "npx tsx --tsconfig tsconfig.checks.json scripts/iris-turn-check.ts",
    "check:iris:flow": "npx tsx --tsconfig tsconfig.checks.json scripts/iris-replay.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "docx": "^9.7.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.45.0",
    "next": "16.2.6",
    "nodemailer": "^10.0.9",
    "openai": "^7.15.0",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "xlsx": "^0.18.5",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
