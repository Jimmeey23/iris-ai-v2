{
  "name": "iris-support-ticket-hub",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:check": "drizzle-kit check",
    "db:seed": "npx tsx -r dotenv/config src/lib/seed.ts",
    "check:iris": "npx tsx --tsconfig tsconfig.checks.json scripts/iris-turn-check.ts",
    "check:iris:flow": "npx tsx --tsconfig tsconfig.checks.json scripts/iris-replay.ts",
    "check:intake": "npx tsx --tsconfig tsconfig.checks.json scripts/intake-check.ts",
    "build:intake-plan": "node scripts/build-intake-plan.mjs",
    "check:history:import": "npx tsx --tsconfig tsconfig.checks.json scripts/history-import-check.ts",
    "db:migrate:equipment": "node scripts/legacy/migrate-equipment.mjs",
    "check:equipment": "npx tsx --tsconfig tsconfig.checks.json scripts/equipment-check.mjs",
    "check:ops": "npx tsx --tsconfig tsconfig.checks.json scripts/ops-check.mjs",
    "check:labels": "npx tsx --tsconfig tsconfig.checks.json scripts/label-check.ts",
    "tickets:relabel": "npx tsx scripts/relabel-tickets.mjs",
    "tickets:repair-routing": "npx tsx scripts/backfill-repair-routing.mjs",
    "check:dashboard": "npx tsx --tsconfig tsconfig.checks.json scripts/dashboard-check.ts",
    "check:dashboard:api": "npx tsx --tsconfig tsconfig.checks.json scripts/dashboard-api-check.mjs",
    "check:webhooks": "npx tsx --tsconfig tsconfig.checks.json scripts/webhook-check.ts",
    "check:emails": "npx tsx --tsconfig tsconfig.checks.json scripts/email-check.ts",
    "check:credentials": "npx tsx --tsconfig tsconfig.checks.json scripts/credentials-check.ts",
    "check:access": "npx tsx --tsconfig tsconfig.checks.json scripts/access-check.ts",
    "accounts:import": "npx tsx --tsconfig tsconfig.checks.json scripts/import-staff-accounts.ts",
    "test": "npm run check:intake && npm run check:labels && npm run check:dashboard && npm run check:webhooks && npm run check:emails && npm run check:credentials && npm run check:access && npm run check:iris"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "@vercel/functions": "^3.9.9",
    "docx": "^9.7.1",
    "drizzle-orm": "0.45.2",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.45.0",
    "next": "16.3.6",
    "nodemailer": "^10.0.9",
    "openai": "^7.15.0",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "^17.3.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
