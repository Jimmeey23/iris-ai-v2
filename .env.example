# Copy this file to .env.local and replace only the values for integrations you use.
# Never commit .env or .env.local; both are ignored by .gitignore.

# Core application services
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
INTEGRATION_ENCRYPTION_KEY=GENERATE_A_64_CHARACTER_HEXADECIMAL_AES_256_KEY

# OpenAI (required for live Iris AI, transcription, and voice replies)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini

# Momence
MOMENCE_USERNAME=YOUR_MOMENCE_USERNAME
MOMENCE_PASSWORD=YOUR_MOMENCE_PASSWORD
MOMENCE_CLIENT_ID=YOUR_MOMENCE_CLIENT_ID
MOMENCE_CLIENT_SECRET=YOUR_MOMENCE_CLIENT_SECRET

# Fillout
FILLOUT_API_KEY=YOUR_FILLOUT_API_KEY
FILLOUT_WEBHOOK_SECRET=YOUR_FILLOUT_WEBHOOK_SECRET

# Google Workspace (shared by Gmail, Calendar, Contacts, Sheets, and Docs)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN

# Optional communication and automation integrations
N8N_WEBHOOK_URL=YOUR_N8N_WEBHOOK_URL
N8N_WEBHOOK_SECRET=YOUR_N8N_WEBHOOK_SECRET
WHATSAPP_ACCESS_TOKEN=YOUR_META_SYSTEM_USER_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_META_PHONE_NUMBER_ID
MAILTRAP_API_KEY=YOUR_MAILTRAP_API_KEY
MAILTRAP_SMTP_HOST=YOUR_MAILTRAP_SMTP_HOST
MAILTRAP_SMTP_PORT=587
MAILTRAP_SMTP_USERNAME=YOUR_MAILTRAP_SMTP_USERNAME
MAILTRAP_SMTP_PASSWORD=YOUR_MAILTRAP_SMTP_PASSWORD
MAILTRAP_FROM_EMAIL=YOUR_VERIFIED_SENDER_EMAIL
RESPOND_API_KEY=YOUR_RESPOND_IO_API_KEY
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL
ZAPIER_WEBHOOK_URL=YOUR_ZAPIER_WEBHOOK_URL
DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL
TEAMS_WEBHOOK_URL=YOUR_TEAMS_WEBHOOK_URL

# Optional productivity and CRM integrations
NOTION_API_KEY=YOUR_NOTION_API_KEY
NOTION_DATABASE_ID=YOUR_NOTION_DATABASE_ID
AIRTABLE_API_KEY=YOUR_AIRTABLE_PERSONAL_ACCESS_TOKEN
AIRTABLE_BASE_ID=YOUR_AIRTABLE_BASE_ID
AIRTABLE_TABLE_NAME=Tickets
TRELLO_API_KEY=YOUR_TRELLO_API_KEY
TRELLO_TOKEN=YOUR_TRELLO_TOKEN
TRELLO_LIST_ID=YOUR_TRELLO_LIST_ID
ASANA_API_KEY=YOUR_ASANA_ACCESS_TOKEN
ASANA_PROJECT_ID=YOUR_ASANA_PROJECT_ID
ZENDESK_SUBDOMAIN=YOUR_ZENDESK_SUBDOMAIN
ZENDESK_EMAIL=YOUR_ZENDESK_AGENT_EMAIL
ZENDESK_API_TOKEN=YOUR_ZENDESK_API_TOKEN
HUBSPOT_API_KEY=YOUR_HUBSPOT_PRIVATE_APP_TOKEN
JIRA_SITE=YOUR_TEAM.atlassian.net
JIRA_EMAIL=YOUR_JIRA_ACCOUNT_EMAIL
JIRA_API_TOKEN=YOUR_JIRA_API_TOKEN
JIRA_PROJECT_KEY=YOUR_JIRA_PROJECT_KEY

# Optional payments and scheduling integrations
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=YOUR_TWILIO_SENDING_NUMBER
CALENDLY_API_KEY=YOUR_CALENDLY_ACCESS_TOKEN
STRIPE_API_KEY=YOUR_STRIPE_RESTRICTED_KEY
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
