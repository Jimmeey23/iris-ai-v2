# ============================================================================
#  IRIS Ai — environment
#
#  Copy to `.env` and fill in what you need:
#      cp .env.example .env
#
#  The variables under "Required" are needed to boot the app and sign in. The
#  "Production" block is needed for a real deployment (Vercel). Every
#  integration below is optional — the app runs without them and simply reports
#  that integration as not configured.
#
#  Credentials can also be saved from the in-app Integrations page, which stores
#  them AES-256-GCM encrypted in the database. Values set here take precedence
#  over saved ones, which makes this file the right place for CI and local dev.
# ============================================================================

# ----------------------------------------------------------------------------
#  Required
# ----------------------------------------------------------------------------

# Postgres connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/iris_support_hub

# 32-byte key as 64 hex characters, used to encrypt integration secrets at rest.
# Generate one with:  openssl rand -hex 32
# Changing this makes every previously saved credential unreadable.
INTEGRATION_ENCRYPTION_KEY=

# Supabase Auth. Sign-in, sign-up, password resets and Google OAuth all run
# through Supabase; this app stores no passwords. Copy these from
# Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older Supabase projects call the same key the "anon" key. Used only when
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is empty.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key. Server-side only — never prefix it with NEXT_PUBLIC_. Used
# for the first-administrator setup and for administrator-created accounts.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
#  Production / deployment
# ----------------------------------------------------------------------------

# One-time token that authorises creating the first administrator from the
# in-app setup dialog. Without it, setup is disabled (so nobody on the internet
# can claim a fresh deployment). Generate with: openssl rand -hex 24
# Remove it once the first administrator exists.
SETUP_TOKEN=

# Comma-separated email domains whose confirmed Supabase users may self-provision
# an agent profile. Anyone else needs an administrator invite.
# Default when unset: physique57india.com
# ALLOWED_EMAIL_DOMAINS=physique57india.com

# Individual addresses outside those domains that may also self-provision an
# agent profile. Comma-separated. Setting this also drops the `hd` hint from
# Google sign-in, so non-domain accounts appear in the account picker.
# Default when unset: jimmeeygondaa@gmail.com
# ALLOWED_EMAILS=jimmeeygondaa@gmail.com

# Bearer secret for the scheduled worker at /api/cron/outbox (outbox retries +
# SLA escalation). Vercel Cron sends it automatically when set on the project.
# Without it the cron route refuses every request. Generate: openssl rand -hex 32
CRON_SECRET=

# Postgres pool size per server instance (default 3 — sized for serverless,
# where every warm function has its own pool). Raise for a long-lived server.
# DB_POOL_MAX=3

# PEM root certificate of the database server (Supabase: Dashboard > Database >
# SSL Configuration > Download certificate). When set, TLS is fully verified
# (rejectUnauthorized=true). Newlines may be written as \n on one line.
# When unset, Supabase connections are encrypted but NOT certificate-verified.
# DATABASE_CA_CERT=

# Demo tickets are opt-in. Leave unset/false in production.
# SEED_DEMO_DATA=false

# ----------------------------------------------------------------------------
#  Optional core settings
# ----------------------------------------------------------------------------

# Overrides the workspace's configured model for Iris.
OPENAI_MODEL=gpt-4o-mini

# Starting port for `npm run dev`. If busy, the next free port is used instead.
# PORT=3000

# Base URL used by scripts/api-check.mjs and scripts/browser-check.mjs.
# TEST_BASE_URL=http://localhost:3000

# Google sign-in is configured in Supabase Dashboard > Authentication >
# Providers > Google, not here. Paste your Google client id and secret there,
# and add Supabase's callback URL to the Google credential. In Supabase
# Authentication > URL Configuration, add <your-app>/auth/callback to the
# redirect allow list for every environment (including http://localhost:3000).

# ============================================================================
#  Integrations
#
#  Naming rule: <INTEGRATION_ID>_<FIELD>, uppercased. The one exception is
#  ChatGPT, whose variables use the OPENAI_ prefix.
# ============================================================================

# Momence — Studio operations
#   Docs: https://api.docs.momence.com/
MOMENCE_USERNAME=
MOMENCE_PASSWORD=
MOMENCE_CLIENT_ID=
MOMENCE_CLIENT_SECRET=

# Bengaluru host credentials. Used server-side when the signed-in reporter's
# workspace profile is linked to a Bengaluru studio.
MOMENCE_USERNAME_BLR=
MOMENCE_PASSWORD_BLR=
MOMENCE_CLIENT_ID_BLR=
MOMENCE_CLIENT_SECRET_BLR=
MOMENCE_API_TOKEN_BLR=

# OpenAI / ChatGPT — Intelligence
#   Docs: https://platform.openai.com/docs
OPENAI_API_KEY=

# n8n — Automation
#   Docs: https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.webhook/
N8N_WEBHOOK_URL=          # e.g. https://your-n8n.example/webhook/iris
N8N_WEBHOOK_SECRET=

# WhatsApp Business — Communication
#   Docs: https://developers.facebook.com/docs/whatsapp/cloud-api/reference/messages/
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=          # e.g. v23.0

# Mailtrap — Communication
#   Docs: https://docs.mailtrap.io/developers/email-sending
MAILTRAP_API_KEY=
MAILTRAP_SMTP_HOST=          # e.g. live.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=          # e.g. 587
MAILTRAP_SMTP_USERNAME=
MAILTRAP_SMTP_PASSWORD=
MAILTRAP_FROM_EMAIL=

# Fillout — Forms & feedback
#   Docs: https://www.fillout.com/help/api-reference/overview
FILLOUT_API_KEY=
FILLOUT_FORM_ID=
# Comma-separated Fillout form IDs to poll and back-fill.
FILLOUT_SCORE_SCALE=          # e.g. 5
FILLOUT_FIELD_MAP=          # e.g. {"rating0":"Your Fillout question label"}
FILLOUT_WEBHOOK_SECRET=
# Trainer review sources shown on /trainers, overriding the built-in list.
# Format: <fillout-form|zite-app>:<id>[:<label>], comma-separated.
# TRAINER_REVIEW_SOURCES=fillout-form:abc123:Barre QA,zite-app:def456

# Gmail — Communication
#   Docs: https://developers.google.com/gmail/api/reference/rest
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Google Calendar — Google Workspace
#   Docs: https://developers.google.com/calendar/api/v3/reference
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_CALENDAR_ID=          # e.g. primary

# Google Contacts — Google Workspace
#   Docs: https://developers.google.com/people/api/rest
GOOGLE_CONTACTS_CLIENT_ID=
GOOGLE_CONTACTS_CLIENT_SECRET=
GOOGLE_CONTACTS_REFRESH_TOKEN=

# Google Sheets — Google Workspace
#   Docs: https://developers.google.com/sheets/api/reference/rest
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REFRESH_TOKEN=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=          # e.g. Tickets!A:Z

# Google Docs — Google Workspace
#   Docs: https://developers.google.com/docs/api/reference/rest
GOOGLE_DOCS_CLIENT_ID=
GOOGLE_DOCS_CLIENT_SECRET=
GOOGLE_DOCS_REFRESH_TOKEN=
GOOGLE_DOCS_DOCUMENT_ID=

# respond.io — Communication
#   Docs: https://developers.respond.io/docs/api
RESPOND_API_KEY=

# Slack — Communication
#   Docs: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Zapier — Automation
#   Docs: https://zapier.com/developer/documentation/v2/rest-hooks/
ZAPIER_WEBHOOK_URL=

# Notion — Productivity
#   Docs: https://developers.notion.com/reference/post-page
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Airtable — Productivity
#   Docs: https://airtable.com/developers/web/api/introduction
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=          # e.g. Tickets

# Trello — Productivity
#   Docs: https://developer.atlassian.com/cloud/trello/rest/api-group-cards/
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# Asana — Productivity
#   Docs: https://developers.asana.com/reference/createtask
ASANA_API_KEY=
ASANA_PROJECT_ID=

# Zendesk — Communication
#   Docs: https://developer.zendesk.com/api-reference/ticketing/tickets/tickets/
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Twilio — Communication
#   Docs: https://www.twilio.com/docs/sms/send-messages
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# HubSpot — CRM
#   Docs: https://developers.hubspot.com/docs/api/crm/tickets
HUBSPOT_API_KEY=

# Calendly — Scheduling
#   Docs: https://developer.calendly.com/api-docs
CALENDLY_API_KEY=

# Stripe — Payments
#   Docs: https://stripe.com/docs/api
STRIPE_API_KEY=

# Razorpay — Payments
#   Docs: https://razorpay.com/docs/api/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Jira — Productivity
#   Docs: https://developer.atlassian.com/cloud/jira/platform/rest/v3/api-group-issues/
JIRA_SITE=          # e.g. yourteam.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Discord — Communication
#   Docs: https://discord.com/developers/docs/resources/webhook
DISCORD_WEBHOOK_URL=

# Microsoft Teams — Communication
#   Docs: https://learn.microsoft.com/microsoftteams/platform/webhooks-and-connectors/how-to/add-incoming-webhook
TEAMS_WEBHOOK_URL=
